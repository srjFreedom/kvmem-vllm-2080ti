[Unit]
Description=KVMem vLLM 2080Ti DFlash2 MTP-style (SM75, 3.5 GiB pool, 2 concurrent, B48K)
After=network-online.target nvidia-persistenced.service
Conflicts=kvmem-vllm.service kvmem-vllm-dflash2.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=srj
Group=srj
Environment=HOME=/home/srj
Environment=KVMEM_MODEL_DIR=/home/srj/models/Coder390/FP8-fp8mtp
Environment=RUN_DIR=/var/tmp/kvmem-run-dflash2-mtpstyle
ExecStartPre=+/bin/rm -rf /var/tmp/kvmem-run-dflash2-mtpstyle
ExecStart=/home/srj/run-kvmem-2080ti-dflash2-mtpstyle.sh start
ExecStop=-/home/srj/run-kvmem-2080ti-dflash2-mtpstyle.sh stop
TimeoutStartSec=900
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
