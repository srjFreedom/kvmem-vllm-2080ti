# Template unit. Substitute the two placeholders before installing, or run
#   ./deploy/install.sh --print-unit
[Unit]
Description=KVMem vLLM (SM75) serving
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO@
Environment=KVMEM_ENGINE_DIR=@ENGINE_DIR@
Environment=CONFIG=@REPO@/local/serve-2080ti-default.json
Environment=RUN_DIR=/var/tmp/kvmem-run-baseline
ExecStart=@REPO@/deploy/run-kvmem-vllm.sh start
ExecStop=@REPO@/deploy/run-kvmem-vllm.sh stop
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
