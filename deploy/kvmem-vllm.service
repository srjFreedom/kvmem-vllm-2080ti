# Template unit. Generate a concrete one with:
#   ./deploy/install.sh --print-unit
[Unit]
Description=KVMem vLLM (SM75) serving
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
ExecStart=@LAUNCHER@ start
ExecStop=-@LAUNCHER@ stop
TimeoutStartSec=900
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
