+    def _aligned_target_mamba(spec):
+        if not isinstance(spec, MambaSpec):
+            return False
+        if spec.mamba_cache_mode == "align":
+            return True
+        # APC off pins the state group to 'none', whose page covers
+        # max_model_len unless the operator sets --mamba-block-size. Once that
+        # block matches the attention block the pages share one layout, which
+        # is all this path needs to plan the target groups on their own.
+        import os as _os
+        if _os.getenv("VLLM_DFLASH_NATIVE_GROUPS_WITHOUT_APC") != "1":
+            return False
+        attention_blocks = {
+            s.block_size for s in target_specs.values()
+            if not isinstance(s, MambaSpec)
+        }
+        return attention_blocks == {spec.block_size}
+
+    if not any(_aligned_target_mamba(spec) for spec in target_specs.values()):
         return None
 
+    # Align draft pages to the attention page size when the target runs without
+    # APC: a 64-token draft page costs one gather per page in the proposer's
+    # sliding window (32 pages for a 2048-token window). Opt-in and geometry
+    # only; the window is token based, so attention semantics are unchanged.
+    import os as _os_align
+    if _os_align.getenv("VLLM_DFLASH_DRAFT_PAGE_ALIGN", "0") == "1":
+        attention_block_sizes = {
+            spec.block_size for spec in target_specs.values()
+            if not isinstance(spec, MambaSpec)
+        }
+        if len(attention_block_sizes) == 1:
+            attention_block_size = next(iter(attention_block_sizes))
+            for name, spec in list(draft_specs.items()):
+                assert isinstance(spec, SlidingWindowSpec)
+                if spec.block_size != attention_block_size:
+                    # page_size_bytes is derived from block_size for attention specs.
+                    draft_specs[name] = replace(spec, block_size=attention_block_size)
+
